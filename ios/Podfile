# iOS 15.5+ required for ML Kit pose detection
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

MLKIT_SIMULATOR_FRAMEWORKS = %w[
  MLImage MLKitCommon MLKitPoseDetection MLKitPoseDetectionAccurate
  MLKitPoseDetectionCommon MLKitVision MLKitXenoCommon
  google_mlkit_commons google_mlkit_pose_detection
].freeze

def strip_mlkit_linker_flags(flags)
  out = flags.dup
  MLKIT_SIMULATOR_FRAMEWORKS.each do |framework|
    out.gsub!(/-framework "#{framework}" /, '')
  end
  out.gsub!(/^\$\(inherited\)\s*/, '')
  out.squeeze(' ').strip
end

def strip_mlkit_framework_search_paths(paths)
  out = paths.dup
  out.gsub!(/"\$\{PODS_ROOT\}\/ML[^"]*" /, '')
  out.gsub!(/"\$\{PODS_CONFIGURATION_BUILD_DIR\}\/google_mlkit_[^"]*" /, '')
  out.gsub!(/^\$\(inherited\)\s*/, '')
  out.squeeze(' ').strip
end

def patch_pods_runner_xcconfig_for_simulator(installer)
  %w[debug profile release].each do |name|
    path = File.join(
      installer.sandbox.root,
      'Target Support Files',
      'Pods-Runner',
      "Pods-Runner.#{name}.xcconfig",
    )
    next unless File.exist?(path)

    contents = File.read(path)
    contents = contents.gsub(
      'EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64',
      'EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386',
    )

    ldflags = contents[/^OTHER_LDFLAGS = (.+)$/, 1]
    framework_paths = contents[/^FRAMEWORK_SEARCH_PATHS = (.+)$/, 1]
    next unless ldflags

    contents = contents.gsub(/^OTHER_LDFLAGS = .+$/, "OTHER_LDFLAGS[sdk=iphoneos*] = #{ldflags}")
    contents << "\nOTHER_LDFLAGS[sdk=iphonesimulator*] = #{strip_mlkit_linker_flags(ldflags)}\n"

    if framework_paths
      contents = contents.gsub(
        /^FRAMEWORK_SEARCH_PATHS = .+$/,
        "FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = #{framework_paths}",
      )
      contents << "FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = #{strip_mlkit_framework_search_paths(framework_paths)}\n"
    end

    File.write(path, contents)
  end
end

def write_flutter_xcconfigs_with_simulator_overrides(installer)
  flutter_dir = File.join(__dir__, 'Flutter')
  {
    'debug' => 'Debug',
    'profile' => 'Profile',
    'release' => 'Release',
  }.each do |pods_name, flutter_name|
    flutter_path = File.join(flutter_dir, "#{flutter_name}.xcconfig")
    File.write(
      flutter_path,
      <<~XCC,
        #include? "../Pods/Target Support Files/Pods-Runner/Pods-Runner.#{pods_name}.xcconfig"
        #include "Generated.xcconfig"
        EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386
      XCC
    )
  end
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
      ]
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      # Apple Silicon simulators need arm64; some pods default to excluding it.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'

      # Google ML Kit's iOS pods do not ship arm64 simulator binaries for
      # current Apple Silicon simulators. Keep ML Kit enabled on real devices,
      # but avoid compiling native ML Kit bridge sources for simulator builds.
      if target.name == 'google_mlkit_pose_detection'
        config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*]'] = 'GoogleMlKitPoseDetectionPlugin.m'
      end
      if target.name == 'google_mlkit_commons'
        config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*]'] = 'GenericModelManager.m MLKVisionImage+FlutterPlugin.m'
      end
    end
  end

  # CocoaPods aggregate xcconfigs: arm64 simulator + ML Kit simulator linker split.
  patch_pods_runner_xcconfig_for_simulator(installer)

  load File.join(__dir__, 'scripts', 'patch_mlkit_simulator_registrant.rb')
  patch_mlkit_simulator_registrant(__dir__)

  write_flutter_xcconfigs_with_simulator_overrides(installer)
end
